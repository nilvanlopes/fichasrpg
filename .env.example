# Cadastro por convite no Authentik. O token fica apenas no backend.
AUTHENTIK_BASE_URL=https://authentik.example.com
AUTHENTIK_API_TOKEN=replace-with-limited-service-token
AUTHENTIK_INVITE_FLOW_SLUG=foundry-enrollment
AUTHENTIK_FOUNDRY_GROUP_NAME=foundry-users
AUTHENTIK_GOOGLE_SOURCE_SLUG=google

# Google é opcional. Autorize no cliente OAuth o callback:
# https://fichasrpg.example.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=
