# Cadastro do FichasRPG. O token fica apenas no backend.
AUTHENTIK_BASE_URL=https://login-fichasrpg.example.com
AUTHENTIK_API_TOKEN=replace-with-limited-service-token

# Credenciais usadas apenas pelo provisionador da source google-fichasrpg.
# Não são encaminhadas ao container da API.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=
